{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "modules": [
    {
      "type": "command",
      "key": "just",
      "text": "just --version | tr '[:upper:]' '[:lower:]'"
    },
    {
      "type": "command",
      "key": "python",
      "text": "python --version | tr '[:upper:]' '[:lower:]'"
    }
  ]
}